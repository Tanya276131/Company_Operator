# --- LLM provider keys (free tiers are enough) ---
GEMINI_API_KEY=
GROQ_API_KEY=
# ANTHROPIC_API_KEY=

# --- Model names live in config, not code. Verify these against each provider's
# --- current model list: names and free-tier availability change often.
GEMINI_FLASH_MODEL=gemini-flash-latest
GEMINI_FLASHLITE_MODEL=gemini-flash-lite-latest
GROQ_TOOL_MODEL=llama-3.3-70b-versatile

# --- LLM record/replay: off | record | replay | auto
#  auto   = use the recording if present, otherwise call the provider and record it
#  replay = never call a provider (reviewers without keys use this)
OPERON_LLM_MODE=auto
OPERON_LLM_RECORDINGS=recordings/llm.jsonl
